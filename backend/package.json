{
  "name": "sgac-braz-backend",
  "version": "7.5.2",
  "description": "Backend para o Sistema de Gestão de Atendimentos do CREAS Brazlândia",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npx prisma generate && tsup",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "db:migrate": "npx prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:backup": "tsx scripts/backup.ts"
  },
  "keywords": [
    "creas",
    "assistencia-social",
    "gestao"
  ],
  "author": "Henrique Rabelo - TDAS",
  "license": "ISC",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/formbody": "^8.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^8.0.3",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.1.0",
    "@prisma/client": "^6.0.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fast-csv": "^5.0.2",
    "fastify": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.2",
    "lru-cache": "^11.0.2",
    "pg": "^8.13.1",
    "prisma": "^6.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@types/node": "^22.10.1",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
