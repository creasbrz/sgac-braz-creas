{
  "name": "sgac-braz-backend",
  "version": "4.5.1",
  "description": "Backend para o Sistema de Gestão de Atendimentos do CREAS Brazlândia",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsup src --out-dir dist",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "db:backup": "tsx scripts/backup.ts",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "creas",
    "assistencia-social",
    "gestao"
  ],
  "author": "DevHelper CREAS",
  "license": "ISC",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "^8.3.0",
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "fast-csv": "^5.0.5",
    "fastify": "^5.6.2",
    "pg": "^8.16.3",
    "prisma": "6.19.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@types/node": "^25.0.1",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
