// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum Cargo {
  Gerente
  Agente_Social
  Especialista
  Auditor
}

enum CaseStatus {
  AGUARDANDO_ACOLHIDA
  EM_ACOLHIDA
  AGUARDANDO_DISTRIBUICAO
  EM_ACOLHIDA_ESPECIALIZADA
  EM_ACOMPANHAMENTO
  EM_MONITORAMENTO
  DESLIGADO
}

enum LogAction {
  CRIACAO
  MUDANCA_STATUS
  ATRIBUICAO
  DESLIGAMENTO
  EVOLUCAO_CRIADA
  AGENDAMENTO_CRIADO
  PAF_CRIADO
  PAF_ATUALIZADO
  ANEXO_ADICIONADO
  MEMBRO_FAMILIA_ADICIONADO
  ENTREGA_BENEFICIO_CRIADA
  ENTREGA_BENEFICIO_ATUALIZADA
  ATIVIDADE_GRUPO_CRIADA
  PRESENCA_REGISTRADA
  OUTRO
}

enum CaseOrigin {
  ESPONTANEA
  DOCUMENTAL
  REFERENCIADA
  BUSCA_ATIVA
}

enum GroupType {
  ACOLHIDA_COLETIVA
  OFICINA
  GRUPO_PAEFI
  REUNIAO_REDE
}

// --- MODELS ---

model User {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  cargo     Cargo
  matricula String?  @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  casosCriados      Case[]               @relation("Criador")
  casosAcolhida     Case[]               @relation("AgenteAcolhida")
  casosPAEFI        Case[]               @relation("EspecialistaPAEFI")
  evolucoes         Evolucao[]
  pafs              Paf[]
  pafVersions       PafVersion[]
  agendamentos      Agendamento[]
  logs              CaseLog[]
  anexos            Anexo[]
  filtrosSalvos     SavedFilter[]
  encaminhamentos   Encaminhamento[]
  entregas          ServiceDeliverable[]
  gruposFacilitados GroupActivity[]
}

model Case {
  id                   String   @id @default(uuid())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  // 1. Identificação
  nomeCompleto         String
  nomeSocial           String?
  cpf                  String   @unique
  nascimento           DateTime
  sexo                 String

  // 2. Contato (Versão 2.0 - Flexível)
  // Armazena array: [{ numero: "...", tipo: "Pessoal", nome: "Mãe" }]
  contatos     Json?

  // 3. Endereço e Localização (Versão 2.0 e 3.0)
  endereco_logradouro  String?
  endereco_complemento String?
  endereco_bairro      String?
  endereco_cidade      String? @default("Brasília")
  endereco_uf          String? @default("DF")
  endereco_cep         String?
  endereco_ra          String? // Essencial para filtros regionais
  
  // Geolocalização (V3.0 - Mapa de Calor)
  latitude             Float?
  longitude            Float?

  // 4. Responsável (Menores/Incapazes)
  responsavelLegal      String?
  parentescoResponsavel String?

  // 5. Dados Técnicos da Demanda
  dataEntrada          DateTime   @default(now())
  orgaoDemandante      String
  origem               CaseOrigin @default(ESPONTANEA)
  urgencia             String
  pesoUrgencia         Int        @default(1)
  violacao             String[] 
  categoria            String
  
  // 6. Dados Administrativos
  numeroSei   String?
  linkSei     String?
  observacoes String?
  status      CaseStatus @default(AGUARDANDO_ACOLHIDA)
  beneficios  String[]   @default([]) // Cache simples de benefícios ativos

  // 7. Gestão de Equipe (Relacionamentos)
  criadoPorId         String
  criadoPor           User   @relation("Criador", fields: [criadoPorId], references: [id])
  
  agenteAcolhidaId    String?
  agenteAcolhida      User?  @relation("AgenteAcolhida", fields: [agenteAcolhidaId], references: [id])
  
  especialistaPAEFIId String?
  especialistaPAEFI   User?  @relation("EspecialistaPAEFI", fields: [especialistaPAEFIId], references: [id])

  // 8. Desligamento
  dataInicioPAEFI     DateTime?
  dataDesligamento    DateTime?
  motivoDesligamento  String?
  destinoDesligamento String?
  parecerFinal        String?
  
  // Soft Delete
  deletado     Boolean   @default(false)
  dataDeletado DateTime?

  // 9. Relacionamentos Detalhados
  evolucoes       Evolucao[]
  paf             Paf?
  agendamentos    Agendamento[]
  logs            CaseLog[]
  anexos          Anexo[]
  encaminhamentos Encaminhamento[]
  familia         MembroFamilia[]
  entregas        ServiceDeliverable[]
  participacoes   GroupAttendance[]

  // Índices para Dashboard e Pesquisa Rápida
  @@index([status])
  @@index([dataEntrada])
  @@index([pesoUrgencia])
  @@index([agenteAcolhidaId])
  @@index([especialistaPAEFIId])
  @@index([violacao])
  @@index([endereco_ra]) // Novo índice para filtros regionais

  @@map("cases")
}

model Evolucao {
  id        String   @id @default(uuid())
  conteudo  String
  sigilo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  casoId    String
  caso      Case     @relation(fields: [casoId], references: [id], onDelete: Cascade)
  
  autorId   String
  autor     User     @relation(fields: [autorId], references: [id])

  @@index([casoId, createdAt(sort: Desc)])
}

model Paf {
  id          String       @id @default(uuid())
  diagnostico String
  objetivos   String
  estrategias String
  deadline    DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  casoId      String       @unique
  caso        Case         @relation(fields: [casoId], references: [id], onDelete: Cascade)
  
  autorId     String
  autor       User         @relation(fields: [autorId], references: [id])
  
  versaoAtual Int          @default(1)
  versoes     PafVersion[]
}

model PafVersion {
  id           String   @id @default(uuid())
  diagnostico  String
  objetivos    String
  estrategias  String
  deadline     DateTime
  savedAt      DateTime @default(now())
  
  pafId        String
  paf          Paf      @relation(fields: [pafId], references: [id], onDelete: Cascade)
  
  autorId      String
  autor        User     @relation(fields: [autorId], references: [id])
  versaoNumero Int      @default(1)
}

model Agendamento {
  id          String   @id @default(uuid())
  titulo      String
  data        DateTime
  tipo        String   @default("Atendimento")
  observacoes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  responsavelId String
  responsavel   User   @relation(fields: [responsavelId], references: [id])
  
  casoId        String
  caso          Case   @relation(fields: [casoId], references: [id], onDelete: Cascade)

  @@index([responsavelId, data])
}

model CaseLog {
  id            String    @id @default(uuid())
  acao          LogAction
  descricao     String
  valorAnterior String?
  valorNovo     String?
  createdAt     DateTime  @default(now())
  
  casoId        String
  caso          Case      @relation(fields: [casoId], references: [id], onDelete: Cascade)
  
  autorId       String
  autor         User      @relation(fields: [autorId], references: [id])
}

model Anexo {
  id        String   @id @default(uuid())
  nome      String
  tipo      String
  url       String
  tamanho   Int?
  createdAt DateTime @default(now())
  
  casoId    String
  caso      Case     @relation(fields: [casoId], references: [id], onDelete: Cascade)
  
  autorId   String
  autor     User     @relation(fields: [autorId], references: [id])
}

model SavedFilter {
  id        String   @id @default(uuid())
  nome      String
  config    Json
  createdAt DateTime @default(now())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Encaminhamento {
  id          String   @id @default(uuid())
  tipo        String
  instituicao String
  motivo      String
  status      String   @default("PENDENTE")
  dataEnvio   DateTime @default(now())
  retorno     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  casoId      String
  caso        Case     @relation(fields: [casoId], references: [id], onDelete: Cascade)
  
  autorId     String
  autor       User     @relation(fields: [autorId], references: [id])
}

model MembroFamilia {
  id          String    @id @default(uuid())
  nome        String
  parentesco  String
  
  idade       Int?
  cpf         String?
  nascimento  DateTime?
  telefone    String?
  ocupacao    String?
  renda       Decimal?  @db.Decimal(10, 2)
  observacoes String?
  
  // [NOVO] Permite registrar violações individuais para o RMA B.6
  violacao    String[]  @default([])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  casoId      String
  caso        Case      @relation(fields: [casoId], references: [id], onDelete: Cascade)
}

model ServiceDeliverable {
  id              String    @id @default(uuid())
  tipo            String    // "Cesta Básica", "Auxílio Natalidade"
  status          String    // "SOLICITADO", "ENTREGUE"
  dataSolicitacao DateTime  @default(now())
  dataEntrega     DateTime?
  observacoes     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  casoId          String
  caso            Case      @relation(fields: [casoId], references: [id], onDelete: Cascade)
  
  responsavelId   String
  responsavel     User      @relation(fields: [responsavelId], references: [id])
}

model GroupActivity {
  id                  String            @id @default(uuid())
  tema                String
  tipo                GroupType
  dataRealizacao      DateTime
  local               String?
  descricao           String?
  orgaosEnvolvidos    String[]          @default([])
  attendanceConfirmed Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  facilitadorId       String
  facilitador         User              @relation(fields: [facilitadorId], references: [id])
  
  participantes       GroupAttendance[]
}

model GroupAttendance {
  id          String        @id @default(uuid())
  presente    Boolean       @default(false)
  observacoes String?
  createdAt   DateTime      @default(now())
  
  grupoId     String
  grupo       GroupActivity @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  
  casoId      String
  caso        Case          @relation(fields: [casoId], references: [id], onDelete: Cascade)

  @@unique([grupoId, casoId])
}