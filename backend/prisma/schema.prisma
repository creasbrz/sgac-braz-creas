// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS (Mantidos inalterados)
// ==========================================

enum Cargo {
  Gerente
  Agente_Social
  Especialista
}

enum CaseStatus {
  AGUARDANDO_ACOLHIDA
  EM_ACOLHIDA
  AGUARDANDO_DISTRIBUICAO_PAEFI
  EM_ACOLHIDA_ESPECIALIZADA
  EM_ACOMPANHAMENTO_PAEFI
  EM_MONITORAMENTO
  DESLIGADO
}

enum LogAction {
  CRIACAO
  MUDANCA_STATUS
  ATRIBUICAO
  DESLIGAMENTO
  EVOLUCAO_CRIADA
  AGENDAMENTO_CRIADO
  PAF_CRIADO
  PAF_ATUALIZADO
  ANEXO_ADICIONADO
  MEMBRO_FAMILIA_ADICIONADO
  ENTREGA_BENEFICIO_CRIADA
  ENTREGA_BENEFICIO_ATUALIZADA
  ATIVIDADE_GRUPO_CRIADA
  PRESENCA_REGISTRADA
  OUTRO
}

enum CaseOrigin {
  ESPONTANEA
  DOCUMENTAL
  REFERENCIADA
  BUSCA_ATIVA
}

enum GroupType {
  ACOLHIDA_COLETIVA
  OFICINA
  GRUPO_PAEFI
  REUNIAO_REDE
}

// ==========================================
// MODELS (Com otimização de performance)
// ==========================================

model User {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  cargo     Cargo
  matricula String?  @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  casosCriados      Case[]          @relation("Criador")
  casosAcolhida     Case[]          @relation("AgenteAcolhida")
  casosPAEFI        Case[]          @relation("EspecialistaPAEFI")
  evolucoes         Evolucao[]
  pafs              Paf[]
  pafVersions       PafVersion[]
  agendamentos      Agendamento[]
  logs              CaseLog[]
  anexos            Anexo[]
  filtrosSalvos     SavedFilter[]
  encaminhamentos   Encaminhamento[]
  entregas          ServiceDeliverable[]
  gruposFacilitados GroupActivity[]

  // PERFORMANCE: Índice para buscas por nome em listagens de usuários
  @@index([nome])
}

model Case {
  id              String      @id @default(uuid())
  nomeCompleto    String
  cpf             String      @unique
  nascimento      DateTime
  sexo            String
  urgencia        String
  pesoUrgencia    Int         @default(1)
  violacao        String
  categoria       String
  telefone        String
  endereco        String
  dataEntrada     DateTime    @default(now())
  orgaoDemandante String
  origem          CaseOrigin  @default(ESPONTANEA)
  numeroSei       String?
  linkSei         String?
  observacoes     String?
  status          CaseStatus  @default(AGUARDANDO_ACOLHIDA)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  criadoPorId         String
  criadoPor           User   @relation("Criador", fields: [criadoPorId], references: [id])
  agenteAcolhidaId    String?
  agenteAcolhida      User?  @relation("AgenteAcolhida", fields: [agenteAcolhidaId], references: [id])
  especialistaPAEFIId String?
  especialistaPAEFI   User?  @relation("EspecialistaPAEFI", fields: [especialistaPAEFIId], references: [id])

  beneficios          String[] @default([])
  dataInicioPAEFI     DateTime?
  dataDesligamento    DateTime?
  motivoDesligamento  String?
  destinoDesligamento String?
  parecerFinal        String?
  deletado            Boolean  @default(false)
  dataDeletado        DateTime?

  evolucoes       Evolucao[]
  paf             Paf?
  agendamentos    Agendamento[]
  logs            CaseLog[]
  anexos          Anexo[]
  encaminhamentos Encaminhamento[]
  familia         MembroFamilia[]
  entregas        ServiceDeliverable[]
  participacoes   GroupAttendance[]

  // PERFORMANCE: Índices essenciais para Dashboard e Filtros
  @@index([status])
  @@index([dataEntrada])
  @@index([pesoUrgencia])
  @@index([nomeCompleto]) // Busca rápida por nome do usuário
  
  // PERFORMANCE: Chaves Estrangeiras (Evita Full Table Scan em joins)
  @@index([criadoPorId])
  @@index([agenteAcolhidaId])
  @@index([especialistaPAEFIId])
}

model Evolucao {
  id        String   @id @default(uuid())
  conteudo  String
  sigilo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  casoId    String
  caso      Case     @relation(fields: [casoId], references: [id], onDelete: Cascade)
  autorId   String
  autor     User     @relation(fields: [autorId], references: [id])

  // PERFORMANCE: Crítico para carregar histórico do caso
  @@index([casoId])
  @@index([autorId])
  @@index([createdAt]) // Para ordenação cronológica rápida
}

model Paf {
  id          String   @id @default(uuid())
  diagnostico String
  objetivos   String
  estrategias String
  deadline    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  casoId      String   @unique
  caso        Case     @relation(fields: [casoId], references: [id], onDelete: Cascade)
  autorId     String
  autor       User     @relation(fields: [autorId], references: [id])
  versaoAtual Int      @default(1)
  versoes     PafVersion[]

  // PERFORMANCE
  @@index([autorId])
}

model PafVersion {
  id           String   @id @default(uuid())
  diagnostico  String
  objetivos    String
  estrategias  String
  deadline     DateTime
  savedAt      DateTime @default(now())
  pafId        String
  paf          Paf      @relation(fields: [pafId], references: [id], onDelete: Cascade)
  autorId      String
  autor        User     @relation(fields: [autorId], references: [id])
  versaoNumero Int      @default(1)

  // PERFORMANCE
  @@index([pafId])
  @@index([autorId])
}

model Agendamento {
  id            String   @id @default(uuid())
  titulo        String
  data          DateTime
  observacoes   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  responsavelId String
  responsavel   User     @relation(fields: [responsavelId], references: [id])
  casoId        String
  caso          Case     @relation(fields: [casoId], references: [id], onDelete: Cascade)

  // PERFORMANCE: Essencial para o Calendário
  @@index([data])
  @@index([responsavelId])
  @@index([casoId])
}

model CaseLog {
  id            String    @id @default(uuid())
  acao          LogAction
  descricao     String
  valorAnterior String?
  valorNovo     String?
  createdAt     DateTime  @default(now())
  casoId        String
  caso          Case      @relation(fields: [casoId], references: [id], onDelete: Cascade)
  autorId       String
  autor         User      @relation(fields: [autorId], references: [id])

  // PERFORMANCE: Auditoria e Histórico
  @@index([casoId])
  @@index([autorId])
  @@index([acao])
  @@index([createdAt])
}

model Anexo {
  id        String   @id @default(uuid())
  nome      String
  tipo      String
  url       String
  tamanho   Int?
  createdAt DateTime @default(now())
  casoId    String
  caso      Case     @relation(fields: [casoId], references: [id], onDelete: Cascade)
  autorId   String
  autor     User     @relation(fields: [autorId], references: [id])

  // PERFORMANCE
  @@index([casoId])
}

model SavedFilter {
  id        String   @id @default(uuid())
  nome      String
  config    Json
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // PERFORMANCE
  @@index([userId])
}

model Encaminhamento {
  id          String   @id @default(uuid())
  tipo        String
  instituicao String
  motivo      String
  status      String   @default("PENDENTE")
  dataEnvio   DateTime @default(now())
  retorno     String?
  casoId      String
  caso        Case     @relation(fields: [casoId], references: [id], onDelete: Cascade)
  autorId     String
  autor       User     @relation(fields: [autorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // PERFORMANCE
  @@index([casoId])
  @@index([status])
}

model MembroFamilia {
  id          String   @id @default(uuid())
  nome        String
  parentesco  String
  idade       Int?
  cpf         String?
  nascimento  DateTime?
  telefone    String?
  ocupacao    String?
  renda       Decimal? @db.Decimal(10, 2)
  observacoes String?
  casoId      String
  caso        Case     @relation(fields: [casoId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // PERFORMANCE
  @@index([casoId])
  @@index([nome]) // Busca por membros da família
}

model ServiceDeliverable {
  id              String   @id @default(uuid())
  tipo            String
  status          String
  dataSolicitacao DateTime @default(now())
  dataEntrega     DateTime?
  observacoes     String?
  casoId          String
  caso            Case     @relation(fields: [casoId], references: [id], onDelete: Cascade)
  responsavelId   String
  responsavel     User     @relation(fields: [responsavelId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // PERFORMANCE
  @@index([casoId])
  @@index([tipo])
}

model GroupActivity {
  id               String      @id @default(uuid())
  tema             String
  tipo             GroupType
  dataRealizacao   DateTime
  local            String?
  descricao        String?
  orgaosEnvolvidos String[]    @default([])
  facilitadorId    String
  facilitador      User        @relation(fields: [facilitadorId], references: [id])
  participantes    GroupAttendance[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // PERFORMANCE
  @@index([facilitadorId])
  @@index([dataRealizacao])
}

model GroupAttendance {
  id          String        @id @default(uuid())
  grupoId     String
  grupo       GroupActivity @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  casoId      String
  caso        Case          @relation(fields: [casoId], references: [id], onDelete: Cascade)
  presente    Boolean       @default(false)
  observacoes String?
  createdAt   DateTime      @default(now())

  @@unique([grupoId, casoId])
  
  // PERFORMANCE
  @@index([grupoId])
  @@index([casoId])
}