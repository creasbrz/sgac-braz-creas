{
  "compilerOptions": {
    // Removemos "composite": true para evitar o erro de emissão
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    
    // Tipos do Node apenas aqui
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "eslint.config.js"
  ]
}